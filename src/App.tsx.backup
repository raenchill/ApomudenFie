import { useState, useEffect } from 'react';
import { BrowserRouter as Router, Routes, Route, Navigate } from 'react-router-dom';
import LandingPage from './pages/LandingPage';
import LoginPage from './pages/auth/LoginPage';
import RegisterPage from './pages/auth/RegisterPage';
import ForgotPasswordPage from './pages/auth/ForgotPasswordPage';
import ResetPasswordPage from './pages/auth/ResetPasswordPage';
import Dashboard from './pages/dashboard/Dashboard';
import SymptomChecker from './pages/dashboard/SymptomChecker';
import Cart from './pages/dashboard/Cart';
import OrderHistory from './pages/dashboard/OrderHistory';
import OrderHistoryWithFirebase from './pages/dashboard/OrderHistoryWithFirebase';
import HealthInsights from './pages/dashboard/HealthInsights';
import PrescriptionUpload from './pages/dashboard/PrescriptionUpload';
import DeliveryPage from './components/DeliveryPage';
import ReceiverDetailsForm, { ReceiverDetails } from './components/ReceiverDetailsForm';
import DeliveryProgress from './components/DeliveryProgress';
import DeliveryProgressWithFirebase from './components/DeliveryProgressWithFirebase';
import DeliveryPageWithFirebase from './components/DeliveryPageWithFirebase';
import { Rider } from './data/riders';
import { CartItem, Medicine, User } from './types';
import AdminDashboard from './pages/admin/AdminDashboard';
import SettingsPage from './pages/SettingsPage';
import { db } from './firebase';
import { doc, updateDoc, serverTimestamp } from 'firebase/firestore';
import WarehouseSetup from './pages/admin/WarehouseSetup';
import { setupWarehouseCollections } from './utils/setupWarehouseCollections';
import runWarehouseSetup from './utils/runWarehouseSetup';

function App() {
  const [user, setUser] = useState<User | null>(null);
  const [cartItems, setCartItems] = useState<CartItem[]>([]);
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedRider, setSelectedRider] = useState<Rider | null>(null);
  const [selectedRiderId, setSelectedRiderId] = useState<string | null>(null);
  const [receiverDetails, setReceiverDetails] = useState<ReceiverDetails | null>(null);
  const [goToReceiverDetails, setGoToReceiverDetails] = useState(false);
  const [goToDeliveryProgress, setGoToDeliveryProgress] = useState(false);

  // Debug useEffect to monitor state changes
  useEffect(() => {
    console.log('State changed:', {
      goToReceiverDetails,
      goToDeliveryProgress,
      selectedRiderId,
      receiverDetails: !!receiverDetails,
      cartItemsLength: cartItems.length
    });
  }, [goToReceiverDetails, goToDeliveryProgress, selectedRiderId, receiverDetails, cartItems.length]);

  const addToCart = (medicine: Medicine) => {
    setCartItems(prev => {
      const existingItem = prev.find(item => item.medicine.id === medicine.id);
      if (existingItem) {
        return prev.map(item =>
          item.medicine.id === medicine.id
            ? { ...item, quantity: item.quantity + 1 }
            : item
        );
      }
      return [...prev, { medicine, quantity: 1 }];
    });
  };

  const updateQuantity = (medicineId: string, quantity: number) => {
    if (quantity <= 0) {
      setCartItems(prev => prev.filter(item => item.medicine.id !== medicineId));
    } else {
      setCartItems(prev =>
        prev.map(item =>
          item.medicine.id === medicineId
            ? { ...item, quantity }
            : item
        )
      );
    }
  };

  const removeItem = (medicineId: string) => {
    setCartItems(prev => prev.filter(item => item.medicine.id !== medicineId));
  };

  const handleLogin = (userData: User) => {
    // If this is a new user, we'll clear the flag after they see the welcome message
    setUser(userData);
  };

  const handleLogout = async () => {
    // Update logout timestamp and set user as inactive in Firestore if user exists
    if (user) {
      try {
        await updateDoc(doc(db, 'users', user.id), {
          lastLogout: serverTimestamp(),
          isActive: false
        });
        console.log('Logout timestamp and status updated for user:', user.name);
      } catch (error) {
        console.error('Error updating logout timestamp:', error);
      }
    }
    
    setUser(null);
    setCartItems([]);
    setSearchQuery('');
  };

  const handleUserUpdate = (updatedUser: User) => {
    setUser(updatedUser);
  };

  const handleSearch = (query: string) => {
    setSearchQuery(query);
  };

  const cartItemsCount = cartItems.reduce((sum, item) => sum + item.quantity, 0);

  return (
    <Router>
      <div className="min-h-screen bg-gray-50">
        <Routes>
          <Route 
            path="/" 
            element={
              user ? <Navigate to="/dashboard" replace /> : <LandingPage />
            } 
          />
          <Route 
            path="/login" 
            element={
              user ? <Navigate to="/dashboard" replace /> : 
              <LoginPage onLogin={handleLogin} />
            } 
          />
          <Route 
            path="/register" 
            element={
              user ? <Navigate to="/dashboard" replace /> : 
              <RegisterPage onRegister={handleLogin} />
            } 
          />
          <Route 
            path="/forgot-password" 
            element={
              user ? <Navigate to="/dashboard" replace /> : 
              <ForgotPasswordPage />
            } 
          />
          <Route 
            path="/reset-password" 
            element={
              user ? <Navigate to="/dashboard" replace /> : 
              <ResetPasswordPage />
            } 
          />
          <Route 
            path="/__/auth/action" 
            element={
              user ? <Navigate to="/dashboard" replace /> : 
              <ResetPasswordPage />
            } 
          />
          <Route 
            path="/dashboard" 
            element={
              user ? (
                <Dashboard 
                  user={user}
                  cartItemsCount={cartItemsCount}
                  onSearch={handleSearch}
                  onLogout={handleLogout}
                  onAddToCart={addToCart}
                  searchQuery={searchQuery}
                  onUserUpdate={handleUserUpdate}
                />
              ) : <Navigate to="/login" replace />
            } 
          />
          <Route 
            path="/symptom-checker" 
            element={
              user ? (
                <SymptomChecker 
                  user={user}
                  cartItemsCount={cartItemsCount}
                  onLogout={handleLogout}
                />
              ) : <Navigate to="/login" replace />
            } 
          />
          <Route 
            path="/cart" 
            element={
              user ? (
                <Cart 
                  user={user}
                  cartItems={cartItems}
                  onUpdateQuantity={updateQuantity}
                  onRemoveItem={removeItem}
                  onLogout={handleLogout}
                />
              ) : <Navigate to="/login" replace />
            } 
          />
          <Route 
            path="/order-history" 
            element={
              user ? <OrderHistoryWithFirebase user={user} /> : <Navigate to="/login" replace />
            } 
          />
          <Route 
            path="/health-insights" 
            element={
              user ? <HealthInsights user={user} /> : <Navigate to="/login" replace />
            } 
          />
          <Route 
            path="/upload-prescription" 
            element={
              user ? <PrescriptionUpload user={user} onAddToCart={addToCart} /> : <Navigate to="/login" replace />
            } 
          />
          <Route 
            path="/delivery"
            element={
              user && cartItems.length > 0 ? (
                <>
                  <DeliveryPageWithFirebase onSelectRider={(rider) => {
                    console.log('Rider selected:', rider);
                    console.log('Setting selectedRiderId to:', rider.id);
                    setSelectedRider(rider);
                    setSelectedRiderId(rider.id);
                    setGoToReceiverDetails(true);
                  }} />
                  {goToReceiverDetails && <Navigate to="/receiver-details" replace />}
                </>
              ) : <Navigate to="/cart" replace />
            }
          />
          <Route
            path="/receiver-details"
            element={
              user && cartItems.length > 0 && selectedRider ? (
                <>
                  <ReceiverDetailsForm onSubmit={(details) => {
                    console.log('Receiver details submitted:', details);
                    setReceiverDetails(details);
                    setGoToDeliveryProgress(true);
                    console.log('Setting goToDeliveryProgress to true');
                  }} />
                  {goToDeliveryProgress && (() => {
                    console.log('Navigating to delivery-progress');
                    return <Navigate to="/delivery-progress" replace />;
                  })()}
                </>
              ) : <Navigate to="/delivery" replace />
            }
          />
          <Route
            path="/delivery-progress"
            element={
              (() => {
                const shouldShow = user && cartItems.length > 0 && selectedRiderId && receiverDetails;
                console.log('Delivery progress route check:', {
                  user: !!user,
                  cartItemsLength: cartItems.length,
                  selectedRiderId: !!selectedRiderId,
                  receiverDetails: !!receiverDetails,
                  goToDeliveryProgress,
                  shouldShow
                });
                
                if (!shouldShow) {
                  console.log('Redirecting to receiver-details due to missing data');
                  return <Navigate to="/receiver-details" replace />;
                }
                
                console.log('Showing delivery progress component with riderId:', selectedRiderId);
                return (
                  <DeliveryProgressWithFirebase
                    riderId={selectedRiderId!}
                    receiver={receiverDetails!}
                    cartItems={cartItems}
                    user={user!}
                    onResetDelivery={() => {
                      setSelectedRider(null);
                      setSelectedRiderId(null);
                      setReceiverDetails(null);
                      setCartItems([]);
                      setGoToReceiverDetails(false);
                      setGoToDeliveryProgress(false);
                      window.location.href = '/';
                    }}
                  />
                );
              })()
            }
          />
          <Route path="/admin" element={<AdminDashboard />} />
          <Route 
            path="/settings" 
            element={
              user ? (
                <SettingsPage user={user} onLogout={handleLogout} onUserUpdate={handleUserUpdate} />
              ) : <Navigate to="/login" replace />
            } 
          />
          <Route path="/warehouse-setup" element={<WarehouseSetup />} />
          <Route path="*" element={<Navigate to="/" replace />} />
        </Routes>
      </div>
    </Router>
  );
}

export default App;
