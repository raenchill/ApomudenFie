rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read/write for files inside pharmacies/{uid}/ path by owner
    match /pharmacies/{pharmacyId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == pharmacyId;
    }

    // Deny other storage access in emulator by default
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
